{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Music Analyzer",
  "version": "0.1.0",
  "identifier": "org.localmusicanalyzer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Local Music Analyzer",
        "width": 640,
        "height": 420,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
